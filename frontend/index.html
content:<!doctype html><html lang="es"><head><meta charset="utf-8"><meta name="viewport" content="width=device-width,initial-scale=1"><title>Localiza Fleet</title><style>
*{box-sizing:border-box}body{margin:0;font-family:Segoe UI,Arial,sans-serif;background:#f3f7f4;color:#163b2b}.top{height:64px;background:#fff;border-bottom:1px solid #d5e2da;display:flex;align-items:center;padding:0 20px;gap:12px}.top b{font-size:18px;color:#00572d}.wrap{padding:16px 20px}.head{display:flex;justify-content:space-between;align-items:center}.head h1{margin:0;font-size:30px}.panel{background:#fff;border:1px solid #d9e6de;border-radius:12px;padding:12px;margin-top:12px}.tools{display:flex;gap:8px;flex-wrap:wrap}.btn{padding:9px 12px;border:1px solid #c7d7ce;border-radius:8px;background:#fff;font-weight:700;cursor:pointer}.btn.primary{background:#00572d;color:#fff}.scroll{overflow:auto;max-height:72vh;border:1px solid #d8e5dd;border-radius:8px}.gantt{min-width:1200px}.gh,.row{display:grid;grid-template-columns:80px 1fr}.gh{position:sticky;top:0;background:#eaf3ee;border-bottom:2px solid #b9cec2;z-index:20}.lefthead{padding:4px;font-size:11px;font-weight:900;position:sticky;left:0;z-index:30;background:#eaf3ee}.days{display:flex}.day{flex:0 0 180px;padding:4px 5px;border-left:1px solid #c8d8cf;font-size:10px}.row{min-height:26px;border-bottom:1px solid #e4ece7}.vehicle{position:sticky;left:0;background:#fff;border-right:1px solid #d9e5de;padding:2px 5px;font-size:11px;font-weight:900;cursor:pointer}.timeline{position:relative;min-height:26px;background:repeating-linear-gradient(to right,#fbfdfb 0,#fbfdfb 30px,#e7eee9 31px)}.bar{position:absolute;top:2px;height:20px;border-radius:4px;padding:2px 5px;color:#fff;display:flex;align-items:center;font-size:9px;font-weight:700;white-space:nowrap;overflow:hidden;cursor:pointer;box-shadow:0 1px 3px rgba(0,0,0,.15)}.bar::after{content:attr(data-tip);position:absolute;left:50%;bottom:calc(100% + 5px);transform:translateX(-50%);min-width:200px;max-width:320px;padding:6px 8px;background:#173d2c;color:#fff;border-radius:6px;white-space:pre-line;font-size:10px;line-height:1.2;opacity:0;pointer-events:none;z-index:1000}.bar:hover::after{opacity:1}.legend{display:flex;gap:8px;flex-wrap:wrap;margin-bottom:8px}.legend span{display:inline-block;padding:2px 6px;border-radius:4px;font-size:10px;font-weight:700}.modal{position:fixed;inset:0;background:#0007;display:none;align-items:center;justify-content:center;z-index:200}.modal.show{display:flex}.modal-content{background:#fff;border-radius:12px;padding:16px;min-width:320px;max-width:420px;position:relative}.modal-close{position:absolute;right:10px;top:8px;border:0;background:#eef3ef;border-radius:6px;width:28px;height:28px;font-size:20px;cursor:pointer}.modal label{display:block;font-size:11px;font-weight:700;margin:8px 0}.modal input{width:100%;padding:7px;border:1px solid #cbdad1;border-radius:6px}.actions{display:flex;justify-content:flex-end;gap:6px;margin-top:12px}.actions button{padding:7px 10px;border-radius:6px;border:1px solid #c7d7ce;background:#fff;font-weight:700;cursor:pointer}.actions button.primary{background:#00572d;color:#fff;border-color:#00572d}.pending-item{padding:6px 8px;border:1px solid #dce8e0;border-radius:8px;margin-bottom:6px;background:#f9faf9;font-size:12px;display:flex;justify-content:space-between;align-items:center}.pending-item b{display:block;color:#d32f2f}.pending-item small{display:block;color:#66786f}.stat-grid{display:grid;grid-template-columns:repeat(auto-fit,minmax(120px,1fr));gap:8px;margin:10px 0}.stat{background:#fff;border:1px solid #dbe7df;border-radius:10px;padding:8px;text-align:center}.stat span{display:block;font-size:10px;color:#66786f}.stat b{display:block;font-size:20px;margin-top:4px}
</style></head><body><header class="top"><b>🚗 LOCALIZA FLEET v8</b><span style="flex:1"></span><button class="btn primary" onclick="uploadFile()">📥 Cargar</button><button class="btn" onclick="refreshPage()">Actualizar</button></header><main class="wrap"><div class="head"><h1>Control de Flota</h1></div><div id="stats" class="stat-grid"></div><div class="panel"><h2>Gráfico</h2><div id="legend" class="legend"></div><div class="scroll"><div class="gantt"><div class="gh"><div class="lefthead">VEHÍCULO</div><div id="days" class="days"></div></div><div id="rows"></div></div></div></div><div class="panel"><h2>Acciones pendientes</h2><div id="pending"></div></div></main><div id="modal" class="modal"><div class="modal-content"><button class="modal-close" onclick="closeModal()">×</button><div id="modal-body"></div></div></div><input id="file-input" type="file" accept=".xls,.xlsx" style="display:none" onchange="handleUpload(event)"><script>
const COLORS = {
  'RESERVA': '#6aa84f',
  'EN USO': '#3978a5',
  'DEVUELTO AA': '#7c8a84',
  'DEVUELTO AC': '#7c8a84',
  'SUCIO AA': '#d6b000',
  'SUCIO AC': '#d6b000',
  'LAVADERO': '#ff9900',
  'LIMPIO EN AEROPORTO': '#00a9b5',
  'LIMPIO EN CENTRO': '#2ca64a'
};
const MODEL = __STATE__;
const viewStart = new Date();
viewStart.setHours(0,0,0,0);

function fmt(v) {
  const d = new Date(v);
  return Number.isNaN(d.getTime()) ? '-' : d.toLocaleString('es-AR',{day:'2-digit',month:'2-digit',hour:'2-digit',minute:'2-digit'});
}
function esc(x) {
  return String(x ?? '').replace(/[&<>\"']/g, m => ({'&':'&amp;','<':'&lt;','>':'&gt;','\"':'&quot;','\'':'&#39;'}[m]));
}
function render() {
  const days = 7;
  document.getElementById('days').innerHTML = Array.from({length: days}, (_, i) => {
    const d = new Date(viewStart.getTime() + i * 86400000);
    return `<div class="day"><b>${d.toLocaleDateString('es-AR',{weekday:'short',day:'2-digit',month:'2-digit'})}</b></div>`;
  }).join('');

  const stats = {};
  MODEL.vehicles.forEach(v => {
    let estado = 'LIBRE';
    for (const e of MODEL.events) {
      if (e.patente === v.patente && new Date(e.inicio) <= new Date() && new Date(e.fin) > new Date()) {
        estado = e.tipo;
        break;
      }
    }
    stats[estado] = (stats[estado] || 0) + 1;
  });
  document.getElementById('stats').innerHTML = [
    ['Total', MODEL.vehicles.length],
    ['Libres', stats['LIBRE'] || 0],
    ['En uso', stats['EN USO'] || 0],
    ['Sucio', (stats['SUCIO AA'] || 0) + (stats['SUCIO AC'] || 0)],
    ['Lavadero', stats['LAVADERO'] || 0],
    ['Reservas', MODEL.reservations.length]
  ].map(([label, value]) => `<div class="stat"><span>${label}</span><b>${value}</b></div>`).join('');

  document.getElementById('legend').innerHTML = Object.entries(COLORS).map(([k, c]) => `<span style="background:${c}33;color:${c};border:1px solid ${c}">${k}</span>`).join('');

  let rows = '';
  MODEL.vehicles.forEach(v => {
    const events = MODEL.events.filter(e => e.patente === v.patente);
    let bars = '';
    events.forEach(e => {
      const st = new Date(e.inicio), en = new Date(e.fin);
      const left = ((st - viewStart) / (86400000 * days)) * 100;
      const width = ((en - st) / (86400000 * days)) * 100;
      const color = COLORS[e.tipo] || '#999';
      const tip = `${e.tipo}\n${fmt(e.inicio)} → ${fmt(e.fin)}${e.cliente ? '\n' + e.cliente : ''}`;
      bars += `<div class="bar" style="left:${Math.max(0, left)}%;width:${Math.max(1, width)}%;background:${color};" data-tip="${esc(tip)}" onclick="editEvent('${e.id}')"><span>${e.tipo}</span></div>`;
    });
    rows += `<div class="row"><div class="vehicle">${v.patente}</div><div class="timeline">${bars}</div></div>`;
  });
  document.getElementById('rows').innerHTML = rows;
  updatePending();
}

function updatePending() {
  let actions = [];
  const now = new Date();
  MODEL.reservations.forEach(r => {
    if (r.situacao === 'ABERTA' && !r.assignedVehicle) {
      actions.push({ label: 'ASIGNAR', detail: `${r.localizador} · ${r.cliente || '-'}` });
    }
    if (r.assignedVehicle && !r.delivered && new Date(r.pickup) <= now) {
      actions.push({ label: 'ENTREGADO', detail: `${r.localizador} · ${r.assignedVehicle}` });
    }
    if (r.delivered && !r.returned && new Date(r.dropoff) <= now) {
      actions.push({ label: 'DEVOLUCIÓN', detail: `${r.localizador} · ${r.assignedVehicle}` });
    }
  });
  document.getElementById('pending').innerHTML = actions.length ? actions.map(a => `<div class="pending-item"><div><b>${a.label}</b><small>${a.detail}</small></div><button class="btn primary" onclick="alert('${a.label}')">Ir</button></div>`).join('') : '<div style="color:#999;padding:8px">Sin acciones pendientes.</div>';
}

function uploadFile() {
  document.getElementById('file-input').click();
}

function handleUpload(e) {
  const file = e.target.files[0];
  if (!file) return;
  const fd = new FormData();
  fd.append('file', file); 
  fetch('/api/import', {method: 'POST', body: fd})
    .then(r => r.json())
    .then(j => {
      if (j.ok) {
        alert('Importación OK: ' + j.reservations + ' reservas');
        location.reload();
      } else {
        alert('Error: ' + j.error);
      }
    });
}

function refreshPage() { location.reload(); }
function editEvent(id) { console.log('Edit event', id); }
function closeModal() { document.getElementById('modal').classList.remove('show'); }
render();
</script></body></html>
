class H(BaseHTTPRequestHandler):
    def send(self, code, ctype, data):
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == '/':
            state = {
                'vehicles': list(model.vehicles.values()),
                'reservations': list(model.reservations.values()),
                'events': model.events,
            }
            html = (ROOT / 'frontend' / 'index.html').read_text(encoding='utf-8').replace('__STATE__', json.dumps(state, ensure_ascii=False))
            self.send(200, 'text/html; charset=utf-8', html.encode('utf-8'))
        elif self.path == '/favicon.ico':
            self.send(404, 'text/plain', b'No favicon')
        else:
            self.send(404, 'text/plain', b'Not found')

    def do_POST(self):
        if self.path == '/api/import':
            try:
                ctype = self.headers.get('Content-Type', '')
                boundary = ctype.split('boundary=', 1)[1].encode() if 'boundary=' in ctype else None
                if not boundary:
                    raise ValueError('Carga multipart inválida')
                length = int(self.headers.get('Content-Length', '0'))
                body = self.rfile.read(length)
                filedata = None
                filename = 'reservas.xlsx'
                for part in body.split(b'--' + boundary):
                    if b'filename=' not in part:
                        continue
                    head, _, data = part.partition(b'\r\n\r\n')
                    m = re.search(br'filename="([^"]+)"', head)
                    if m:
                        filename = m.group(1).decode('utf-8', 'ignore')
                    filedata = data.rstrip(b'\r\n-')
                    break
                if filedata is None:
                    raise ValueError('Archivo no recibido')
                td = Path(tempfile.mkdtemp())
                p = td / filename
                p.write_bytes(filedata)
                payload = import_reservation_file(p)
                model.import_reservations(payload)
                self.send(200, 'application/json', json.dumps({'ok': True, 'reservations': len(payload.get('reservations', []))}).encode())
            except Exception as e:
                self.send(400, 'application/json', json.dumps({'ok': False, 'error': str(e)}).encode())
        elif self.path == '/api/deliver':
            try:
                data = json.loads(self.rfile.read(int(self.headers.get('Content-Length', 0))))
                ok = model.deliver_vehicle(data['localizador'], data['real_time'])
                self.send(200, 'application/json', json.dumps({'ok': ok}).encode())
            except Exception as e:
                self.send(400, 'application/json', json.dumps({'ok': False, 'error': str(e)}).encode())
        elif self.path == '/api/return':
            try:
                data = json.loads(self.rfile.read(int(self.headers.get('Content-Length', 0))))
                ok = model.return_vehicle(data['localizador'], data['real_time'])
                self.send(200, 'application/json', json.dumps({'ok': ok}).encode())
            except Exception as e:
                self.send(400, 'application/json', json.dumps({'ok': False, 'error': str(e)}).encode())
        else:
            self.send(404, 'application/json', b'{"ok": false, "error": "ruta no encontrada"}')


